# Sena Environment Configuration

# Database (PostgreSQL with pooling - DigitalOcean / Neon / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/sena_db?sslmode=require"

# Redis / Valkey (DigitalOcean Managed Redis)
REDIS_URL="redis://default:password@localhost:6379"

# Paystack (Payment Gateway)
PAYSTACK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxx"
PAYSTACK_WEBHOOK_SECRET="whsec_xxx"

# Storage (DigitalOcean Spaces / S3 Compatible)
SPACES_KEY="DO_SPACES_KEY"
SPACES_SECRET="DO_SPACES_SECRET"
SPACES_ENDPOINT="https://fra1.digitaloceanspaces.com"
SPACES_BUCKET="sena-media"
SPACES_CDN_URL="https://sena-media.fra1.cdn.digitaloceanspaces.com"

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
NEXT_PUBLIC_BOOKING_URL="http://localhost:3002"
NEXT_PUBLIC_MARKETING_URL="http://localhost:3003"

# Auth & Security
AUTH_SECRET="sena_super_secret_auth_key_min_32_characters"
ENCRYPTION_KEY="sena_hex_encoded_32_byte_encryption_key"
SENA_INTEGRATION_ENCRYPTION_KEY=""

# Connected Apps OAuth (set in deployment secrets — never commit real values)
# SENA_ZOHO_INVOICE_CLIENT_ID=
# SENA_ZOHO_INVOICE_CLIENT_SECRET=
# SENA_ZOHO_BOOKS_CLIENT_ID=
# SENA_ZOHO_BOOKS_CLIENT_SECRET=
# SENA_ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com
# SENA_GOOGLE_CALENDAR_CLIENT_ID=
# SENA_GOOGLE_CALENDAR_CLIENT_SECRET=
# SENA_WHATSAPP_CLIENT_ID=
# SENA_WHATSAPP_CLIENT_SECRET=
# SENA_SYNC_CRON_SECRET=
# SENA_ADMIN_OBSERVABILITY_TOKEN=
SENA_PUBLIC_APP_ORIGIN="https://app.example.com"

# Observability (Optional)
NEXT_PUBLIC_POSTHOG_KEY=""
SENTRY_DSN=""
