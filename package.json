{
  "name": "sena",
  "private": true,
  "description": "Sena - Operating system for modern hospitality businesses",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "test": "pnpm test:list && pnpm test:list-routes",
    "test:list": "tsx scripts/test-list-pagination.ts",
    "test:list-routes": "TSX_TSCONFIG_PATH=apps/dashboard/tsconfig.json tsx scripts/test-list-routes.ts",
    "test:concurrency": "TSX_TSCONFIG_PATH=apps/dashboard/tsconfig.json tsx scripts/test-db-concurrency.ts",
    "test:guest-edit": "TSX_TSCONFIG_PATH=apps/dashboard/tsconfig.json tsx scripts/test-guest-edit-route.ts",
    "test:load-guard": "tsx scripts/test-load-test-guard.ts",
    "test:release": "tsx scripts/test-release.ts",
    "db:preflight": "tsx scripts/production-preflight-check.ts",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.13.4",
    "bcryptjs": "^3.0.3",
    "prettier": "^3.5.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  }
}
